{
  "permissions": {
    "allow": [
      "Bash(bazel build:*)",
      "Bash(bazel test:*)",
      "Bash(bazel query:*)",
      "Bash(bazel run //:buildifier)",
      "Bash(bazel run //:format:*)",
      "Bash(bazel run //:coverage_gate)",
      "Bash(bazel run @buildozer:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/tools/setup.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
