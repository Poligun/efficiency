load("//tools/typescript:defs.bzl", "ts_library", "ts_test")

# One ts_library per directory, its tests beside it. The wrapper declares
# the type check, the ESLint test and the format test over these files.
ts_library(
    name = "greeting",
    srcs = ["greeting.tsx"],
    tsconfig = "//typescript/web:tsconfig",
    visibility = ["//typescript/web:__subpackages__"],
    deps = [
        "//typescript:node_modules/@types/react",
        "//typescript:node_modules/react",
    ],
)

ts_test(
    name = "greeting_test",
    srcs = ["greeting_test.tsx"],
    config = "//typescript/web:vite_config",
    tsconfig = "//typescript/web:tsconfig",
    deps = [
        ":greeting",
        "//typescript:node_modules/@testing-library/react",
        "//typescript:node_modules/@types/react",
        "//typescript:node_modules/jsdom",
        "//typescript:node_modules/react",
        "//typescript:node_modules/vitest",
    ],
)
